.jackcenter{
    text-align: center;
    color: rgb(1, 23, 27);
    background-color: rgb(236, 232, 230);
}
.jack{
    background-color: rgb(31, 220, 220);
    border-radius: 15px;
    padding: 20px 30px;
    border-radius: 15px;
    color: rgb(223, 25, 25);
    margin: 0 auto ;
    width:  80%;
    height: 100px;
    overflow: auto;
    font-family: "Noto Serif TC" Serif;
}

.centercenter{
    text-align: center;
}
.blueblue{
    color: blue;
}
.jacklink:hover{
    color: blue;
    padding: 0 30px;
    border-radius: 40px;
    background-color: aqua;
}
.row{
    display: flex;
    flex-wrap: wrap;
    margin-right: calc(-0.5 * var(--bs-gutter-x));
    margin-top: calc(-1 * var(--bs-gutter-y));
    margin-left: calc(-0.5 * var(--bs-gutter-x));
}
.jackbig{
    font-size: 20px;
    font-weight: 800;
}
.jackgo{
    font-size: 50px;
    text-align: center;
}
section#about{
    background-color: rgb(106, 233, 233) !important;
    background-image: url("../assets/img/星空\ \(1\).jpg");
    background-attachment: fixed;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    
}
section#about div{
    color: rgb(11, 1, 1); }
section#about h1{
  color:white;
}
section#callme {
    background-color: rgb(116 23 133) !important;
}
section#callme h2{
    color: white;
}
.jackyao{
     width: 100%; 
     height: 250px; 
     object-fit: cover;
     text-align: center;
}
p{font-family: "Noto Serif TC" Serif;}
span{font-family: "Noto Serif TC" Serif;}